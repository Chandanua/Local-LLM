# Ollama server URL
OLLAMA_HOST=http://127.0.0.1:11434

# Chat model name
CHAT_MODEL=qwen3.5:4b

# Embedding model name (runs on CPU)
EMBED_MODEL=embeddinggemma

# Folder for chats and profile
DATA_DIR=D:\LLM storage

# Context window tokens
NUM_CTX=32768

# Max tokens generated per reply
NUM_PREDICT=2048

# How long Ollama keeps models loaded
KEEP_ALIVE=30m
